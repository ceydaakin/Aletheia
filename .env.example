# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Gateway ---
GATEWAY_ADDR=:8080
GATEWAY_LOG_LEVEL=info
# Total wall-clock budget for one /v1/answer request. NFR target: p95 <= 3.5s.
GATEWAY_REQUEST_TIMEOUT_MS=6000
# Per-stage deadlines (must sum to less than GATEWAY_REQUEST_TIMEOUT_MS).
GATEWAY_RETRIEVAL_TIMEOUT_MS=1200
GATEWAY_GENERATION_TIMEOUT_MS=3000
GATEWAY_VERIFIER_TIMEOUT_MS=1500
GATEWAY_RISK_TIMEOUT_MS=500

# --- Upstream service URLs (as seen from the gateway container) ---
RETRIEVAL_URL=http://retrieval:8001
GENERATION_URL=http://generation:8002
VERIFIER_URL=http://verifier:8003
RISK_URL=http://risk:8004

# --- Tenants ---
# Format: <tenant_id>:<api_key>:<default_risk_budget>, comma separated.
# Scaffold-only static registry; replaced by the tenants table in week 8.
ALETHEIA_TENANTS=demo:demo-key-change-me:0.05

# --- Postgres ---
POSTGRES_USER=aletheia
POSTGRES_PASSWORD=aletheia
POSTGRES_DB=aletheia
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aletheia:aletheia@postgres:5432/aletheia

# --- NATS ---
NATS_URL=nats://nats:4222
NATS_INGEST_STREAM=aletheia-ingest
INGEST_SUBJECT=ingest.document
INGEST_DURABLE=aletheia-ingest-worker
# A document that keeps failing is a poison message; past this it is marked
# failed and dropped, so one bad PDF cannot block the rest of the corpus.
INGEST_MAX_ATTEMPTS=3

# --- Chunking ---
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=150
CHUNK_MIN_CHARS=120

# --- Embedding ---
# "null" stores no vectors and leaves chunks lexically retrievable; the dense arm
# is simply absent and RRF over one list is that list's ranking.
# "sentence-transformers" needs the `models` extra; backfill existing chunks with
#   python -m aletheia.ingestion.backfill --tenant demo
EMBEDDING_BACKEND=null

# --- Retrieval ---
# The arms are wider than what generation sees: recall cannot be recovered
# downstream, precision can (ADR-0006).
RETRIEVAL_LEXICAL_K=50
RETRIEVAL_DENSE_K=50
RETRIEVAL_RRF_K=60
RETRIEVAL_TOP_N=6

# "null" preserves fusion order and keeps the stack runnable without torch;
# "cross-encoder" needs the `models` extra.
RERANKER_BACKEND=null
RERANK_MAX_CANDIDATES=32

# --- Models ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- Generation ---
# "extractive" selects sentences from the retrieved chunks: deterministic, no
# key, and INCAPABLE OF HALLUCINATING — so a bound calibrated against it measures
# retrieval and verifier strictness, not unsupported generation, and does not
# transfer to a generative system. "anthropic" needs ANTHROPIC_API_KEY.
GENERATION_BACKEND=extractive
GENERATION_MAX_CLAIMS=4

# --- Verifier ---
# "overlap" is the model-free baseline and an ablation row; it scores a claim
# that contradicts its evidence at or above the support threshold, so it accepts
# false claims by construction. "nli" scores P(entailment) and needs the `models`
# extra.
VERIFIER_BACKEND=overlap
VERIFIER_BATCH_SIZE=16
SUPPORT_THRESHOLD=0.5

# --- Risk control defaults ---
DEFAULT_RISK_BUDGET=0.05
RISK_CONFIDENCE=0.95
# Calibration older than this is considered stale -> abstain(stale_calibration).
CALIBRATION_MAX_AGE_HOURS=168

# --- Admission control (per tenant) ---
# Without this one tenant's batch job consumes the verifier's throughput and
# every other tenant's requests time out — and a timed-out verifier becomes an
# abstention, so the noisy neighbour silently degrades other tenants' answers.
GATEWAY_RATE_LIMIT_PER_SECOND=10
GATEWAY_RATE_LIMIT_BURST=20
GATEWAY_MAX_CONCURRENT_PER_TENANT=20
